@* A textarea with a coloured copy of its text behind it, so each part of the token shows in its own colour *@

<div class="token-input">
    <div class="token-backdrop" aria-hidden="true">@foreach ((string text, string css) in Segments()){<span class="@css">@text</span>}@("\n ")</div>
    <textarea value="@Value" @oninput="OnInput" placeholder="Paste a JWT here…"
              spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off"></textarea>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    // header.payload.signature for a JWS, header.key.iv.ciphertext.tag for a JWE
    private IEnumerable<(string Text, string Css)> Segments()
    {
        string[] parts = Value.Split('.');
        for (int i = 0; i < parts.Length; i++)
        {
            if (i > 0)
            {
                yield return (".", "token-dot");
            }

            yield return (parts[i], $"token-part-{i % 5}");
        }
    }
}

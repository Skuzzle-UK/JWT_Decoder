<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:JwtDecoder.App"
             xmlns:components="clr-namespace:JwtDecoder.App.Components"
             x:Class="JwtDecoder.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#202020}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#202020}">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
